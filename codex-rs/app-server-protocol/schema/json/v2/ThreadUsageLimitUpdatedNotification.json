{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "UsageLimitClassification": {
      "description": "Classification of a waitable usage-limit encounter.",
      "oneOf": [
        {
          "description": "Account usage-window exhaustion with an authoritative reset timestamp.",
          "enum": [
            "usageWindow"
          ],
          "type": "string"
        },
        {
          "description": "Transient response-stream rate limit.",
          "enum": [
            "transientRateLimit"
          ],
          "type": "string"
        },
        {
          "description": "Generic HTTP 429 with no structured reset metadata.",
          "enum": [
            "genericTooManyRequests"
          ],
          "type": "string"
        }
      ]
    },
    "UsageLimitManualWaitReason": {
      "description": "Why automatic probing stopped and manual retry is required.",
      "oneOf": [
        {
          "description": "`auto_resume` is disabled.",
          "enum": [
            "autoResumeDisabled"
          ],
          "type": "string"
        },
        {
          "description": "`max_auto_resumes` has been reached.",
          "enum": [
            "autoResumeLimitReached"
          ],
          "type": "string"
        },
        {
          "description": "`max_availability_checks` has been reached.",
          "enum": [
            "availabilityCheckLimitReached"
          ],
          "type": "string"
        },
        {
          "description": "`unknown_reset_max_wait_seconds` wall-clock ceiling reached.",
          "enum": [
            "waitCeilingReached"
          ],
          "type": "string"
        }
      ]
    },
    "UsageLimitSnapshot": {
      "description": "Immutable snapshot of the coordinator state for a single wait generation.",
      "properties": {
        "autoResumeEnabled": {
          "description": "Whether automatic resume is enabled for this generation.",
          "type": "boolean"
        },
        "automaticResumesUsed": {
          "description": "Number of automatic resumes consumed so far.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "availabilityChecksUsed": {
          "description": "Number of unknown-reset probes issued so far.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "classification": {
          "allOf": [
            {
              "$ref": "#/definitions/UsageLimitClassification"
            }
          ],
          "description": "Classification of the original encounter."
        },
        "expectedParticipants": {
          "description": "Thread IDs expected to park before a probe is elected.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "generation": {
          "description": "Monotonic generation; stale callbacks compare against this.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "leaderThreadId": {
          "description": "Thread ID of the elected revalidation leader, if any.",
          "type": [
            "string",
            "null"
          ]
        },
        "limitId": {
          "description": "Limit identifier, if known.",
          "type": [
            "string",
            "null"
          ]
        },
        "manualRetryRequested": {
          "description": "Whether a manual retry has been requested and is pending election.",
          "type": "boolean"
        },
        "manualWaitReason": {
          "anyOf": [
            {
              "$ref": "#/definitions/UsageLimitManualWaitReason"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why manual wait was entered, if applicable."
        },
        "maxAutoResumes": {
          "description": "Maximum automatic resumes allowed.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "maxAvailabilityChecks": {
          "description": "Maximum unknown-reset probes allowed.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "nextCheckAt": {
          "description": "Next scheduled check time (Unix seconds), if any.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "parkedThreadIds": {
          "description": "Thread IDs registered as parked.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "phase": {
          "allOf": [
            {
              "$ref": "#/definitions/UsageLimitWaitPhase"
            }
          ],
          "description": "Current phase."
        },
        "resetAt": {
          "description": "Known reset timestamp (Unix seconds), if available.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "triggerThreadId": {
          "description": "The thread that triggered the wait.",
          "type": "string"
        },
        "triggerTurnId": {
          "description": "The turn that triggered the wait.",
          "type": "string"
        },
        "unknownResetMaxWaitSeconds": {
          "description": "Maximum unknown-reset wait in seconds.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "unknownResetWaitStartedAt": {
          "description": "When the first unknown-reset probe was issued (Unix seconds), if any.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "workId": {
          "description": "The causal work ID (root turn ID).",
          "type": "string"
        }
      },
      "required": [
        "autoResumeEnabled",
        "automaticResumesUsed",
        "availabilityChecksUsed",
        "classification",
        "expectedParticipants",
        "generation",
        "manualRetryRequested",
        "maxAutoResumes",
        "maxAvailabilityChecks",
        "parkedThreadIds",
        "phase",
        "triggerThreadId",
        "triggerTurnId",
        "unknownResetMaxWaitSeconds",
        "workId"
      ],
      "type": "object"
    },
    "UsageLimitWaitPhase": {
      "description": "Phase of a usage-limit wait.",
      "oneOf": [
        {
          "description": "Work is queued before any execution effect.",
          "enum": [
            "queued"
          ],
          "type": "string"
        },
        {
          "description": "Work is transitioning to suspended after effects were observed.",
          "enum": [
            "suspending"
          ],
          "type": "string"
        },
        {
          "description": "Work is suspended after effects were observed.",
          "enum": [
            "suspended"
          ],
          "type": "string"
        },
        {
          "description": "A leader probe is in flight to revalidate capacity.",
          "enum": [
            "revalidating"
          ],
          "type": "string"
        },
        {
          "description": "Capacity was admitted; parked agents are resuming.",
          "enum": [
            "resuming"
          ],
          "type": "string"
        },
        {
          "description": "Automatic probing is exhausted; manual retry is required.",
          "enum": [
            "manualWait"
          ],
          "type": "string"
        },
        {
          "description": "A non-recoverable issue requires user attention.",
          "enum": [
            "attentionRequired"
          ],
          "type": "string"
        },
        {
          "description": "The wait was cancelled.",
          "enum": [
            "cancelled"
          ],
          "type": "string"
        }
      ]
    }
  },
  "description": "Notification payload for `thread/usageLimit/updated`.",
  "properties": {
    "snapshot": {
      "anyOf": [
        {
          "$ref": "#/definitions/UsageLimitSnapshot"
        },
        {
          "type": "null"
        }
      ],
      "description": "Current coordinator snapshot, or `null` if the wait cleared."
    },
    "threadId": {
      "type": "string"
    }
  },
  "required": [
    "threadId"
  ],
  "title": "ThreadUsageLimitUpdatedNotification",
  "type": "object"
}